# ==============================================================================
# MALLMIND AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Target Venue: Nexus Ahmedabad One (Alpha One Mall), Vastrapur, Ahmedabad
# Copy this file to .env in each corresponding directory or set environment variables.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=mallmind
POSTGRES_USER=mallmind
POSTGRES_PASSWORD=mallmind_dev_password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mallmind
DB_USERNAME=mallmind
DB_PASSWORD=mallmind_dev_password

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Java 21 / Spring Boot 3.2+)
# ------------------------------------------------------------------------------
SERVER_PORT=8085
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SQL_INIT_MODE=never

# Security / JWT Secret (must be at least 32 characters / 256 bits for HMAC-SHA256)
JWT_SECRET=dev-only-change-this-secret-change-this-secret-32bytes-minimum
JWT_EXPIRATION_MINUTES=120

# AI Model Service Integration URL
MODEL_SERVICE_BASE_URL=http://localhost:8001

# Logging
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. AI MODEL SERVICE CONFIGURATION (Python 3.11+ / FastAPI)
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
WHISPER_MODEL_SIZE=tiny
TORCH_DEVICE=cpu

# Database direct connection for analytics and demand features
DATABASE_URL=postgresql://mallmind:mallmind_dev_password@localhost:5433/mallmind

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (React 19 + Vite)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8085
VITE_MODEL_SERVICE_URL=http://localhost:8001
